<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="28603Erianna.BedrockVoiceChat"
    Publisher="CN=75872BB1-5DEC-4DF2-B195-17FD6189847D"
    Version="__VERSION_4PART__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Bedrock Voice Chat</DisplayName>
    <PublisherDisplayName>Charles R. Portwood II</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="bedrock-voice-chat-client.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Bedrock Voice Chat"
        Description="Proximity voice chat for Minecraft Bedrock, and other Games"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="bedrock-voice-chat" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
