{
  "name": "bedrock-voice-chat-client",
  "version": "1.0.0-beta.20",
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "yarn preloader:build && vite dev",
    "build": "yarn i18n:build && yarn preloader:build && vite build",
    "i18n:build": "node --disable-warning=ExperimentalWarning scripts/i18n/build.mjs",
    "i18n:extract": "node --disable-warning=ExperimentalWarning scripts/i18n/extract.mjs",
    "i18n:check": "node --disable-warning=ExperimentalWarning scripts/i18n/extract.mjs --check",
    "i18n:report": "node --disable-warning=ExperimentalWarning scripts/i18n/report.mjs",
    "i18n:decisions": "node --disable-warning=ExperimentalWarning scripts/i18n/decisions.mjs",
    "preloader:build": "vite build --config vite.preloader.config.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "radial:dev": "vite dev --config vite.radial.config.ts",
    "radial:build": "vite build --config vite.radial.config.ts",
    "radial:preview": "vite preview --config vite.radial.config.ts",
    "radial:test": "node --test --experimental-strip-types --import ./src/radial/tests/register.mjs \"./src/radial/tests/*.test.ts\"",
    "radial:test:coverage": "node --test --experimental-strip-types --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov-radial.info --import ./src/radial/tests/register.mjs \"./src/radial/tests/*.test.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bindings:index": "node scripts/generate-bindings-index.mjs",
    "bindings:check": "node scripts/generate-bindings-index.mjs && git diff --exit-code --quiet src/js/bindings/index.ts",
    "tauri:ios:init": "tauri ios init && cp src-tauri/Info.ios.plist src-tauri/gen/apple/bedrock-voice-chat-client_iOS/Info.plist && cp -R src-tauri/icons/Assets.xcassets src-tauri/gen/apple/ && node ../.github/scripts/patch-apple-plists.js && node ../.github/scripts/patch-entitlements.js",
    "asyncapi-docs": "cargo run --manifest-path ../common/websocket-types/Cargo.toml --bin generate-asyncapi-docs"
  },
  "license": "UNLICENSED",
  "resolutions": {
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-iap-api": "0.10.0-rc.1",
    "@sentry/browser": "^10.43.0",
    "@sentry/vite-plugin": "^5.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "git+https://github.com/charlesportwoodii/tauri-plugin-deep-link.git#master",
    "@tauri-apps/plugin-dialog": "^2.7",
    "@tauri-apps/plugin-fs": "^2.5",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@use-gesture/vanilla": "^10.3",
    "murmurhash3js": "^3.0",
    "tauri-plugin-age-signals": "git+https://github.com/charlesportwoodii/tauri-plugin_age-signals.git#master",
    "tauri-plugin-audio-permissions": "git+https://github.com/charlesportwoodii/tauri-plugin-audio-permissions.git#master"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4",
    "@testing-library/jest-dom": "^7.0",
    "@testing-library/svelte": "^5.4",
    "@testing-library/user-event": "^14.6",
    "@types/node": "^25",
    "@vitest/coverage-v8": "^4.1",
    "autoprefixer": "^10.4",
    "axios": "^1.8",
    "baseline-browser-mapping": "^2.9.11",
    "gettext-extractor": "^4.0.6",
    "gettext-parser": "^9.1.1",
    "happy-dom": "^20.11",
    "postcss": "^8.4",
    "postcss-import": "^16.1",
    "prettier": "^3.4",
    "svelte": "^5.46",
    "svelte-check": "^4.1",
    "typescript": "^6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1"
  }
}
