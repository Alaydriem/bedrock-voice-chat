# Local dev-server configuration. Copy to `.env` (which is gitignored) and edit.
# Consumed by `yarn dev-server`.

# Absolute path to the java.exe used to launch the Paper/Fabric servers.
# Set this so dev-server does not depend on whatever java is first on PATH.
JAVA_BIN=C:\Program Files\Microsoft\jdk-25.0.2.10-hotspot\bin\java.exe

# Server root directories (NOT the mods/plugins/dev-pack subfolders — dev-server
# derives those: paper -> plugins, fabric -> mods, bds -> development_*_packs).
BDS_SERVER_PATH=C:\Users\charl\Minecraft\minecraft-test-servers\Bedrock\bedrock-server-1.26.33.2
PAPER_SERVER_PATH=C:\Users\charl\Minecraft\minecraft-test-servers\Papermc\java-server-papermc-26.2
FABRIC_SERVER_PATH=C:\Users\charl\Minecraft\minecraft-test-servers\Fabric\java-server-fabric-26.2

# Optional JVM heap for the Paper/Fabric servers (defaults: 4G / 4G).
# JVM_XMS=4G
# JVM_XMX=4G
