# Local dev-server configuration. Copy to `.env` (which is gitignored) and edit.
# Consumed by `yarn dev-server`. Only BDS requires this file.

# java.exe used to launch the Paper/Fabric servers (default: `java` on PATH, which
# the mise dev-paper/dev-fabric tasks pin to java@temurin-25).
JAVA_BIN=

# Server root directories (NOT the mods/plugins/dev-pack subfolders — dev-server
# derives those: paper -> plugins, fabric -> mods, bds -> development_*_packs).
BDS_SERVER_PATH=C:\Users\charl\Minecraft\minecraft-test-servers\Bedrock\bedrock-server-1.26.33.2

# Paper and Fabric (all optional). The server, Geyser, Floodgate and Simple Voice
# Chat (plus Fabric API on Fabric) are downloaded on first run, the EULA is
# accepted, and the BVC config and certificates are mirrored from the
# PowerNukkitX dev server. `yarn dev-server --paper --update` re-resolves builds.
# Server directories (default: mods/.dev/paper, mods/.dev/fabric).
PAPER_SERVER_PATH=
FABRIC_SERVER_PATH=
# Minecraft version to provision (default: 26.3).
PAPER_MC_VERSION=
FABRIC_MC_VERSION=

# Optional JVM heap for the Paper/Fabric servers (defaults: 4G / 4G).
# JVM_XMS=4G
# JVM_XMX=4G

# PowerNukkitX (both optional). The server is downloaded and seeded on first run.
# Server directory (default: mods/.dev/powernukkitx).
PNX_SERVER_PATH=
# java.exe used to launch PowerNukkitX (default: mise's java@temurin-21).
PNX_JAVA_BIN=
