    "@types/archiver": "^6.0.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^8",
    "archiver": "^7.0.1",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "prettier": "^3",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
