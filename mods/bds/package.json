{
  "name": "bedrock-voice-chat-scripts",
  "version": "1.0.0-beta.12",
  "description": "TypeScript scripts for Bedrock Voice Chat addon",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
