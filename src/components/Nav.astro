---
import Button from './Button.astro';
import Mark from './Mark.astro';
import { copy } from '../copy';
import { LINKS } from '../lib/site';

const t = copy.nav;
const links = [
  { id: 'how', href: '#how' },
  { id: 'platforms', href: '#download' },
  { id: 'operators', href: '#operators' },
  { id: 'wiki', href: LINKS.wiki },
  { id: 'integrations', href: '#integrations' },
] as const;
---

<header class="nav">
  <a class="brand" href="/">
    <Mark cell={3} />
    <span>Bedrock Voice Chat</span>
  </a>

  <nav class="panel" data-nav-panel aria-label={t.ariaLabel}>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{t.links[l.id]}</a>
          </li>
        ))
      }
    </ul>
    <div class="cta">
      <Button href={LINKS.discord} size="sm" external>{t.discord}</Button>
      <Button href="#download" size="sm" variant="primary">{t.download}</Button>
    </div>
  </nav>

  <button class="burger" data-nav-toggle aria-expanded="false" aria-label={t.menu}>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-inline: var(--pad-page);
    border-bottom: 1px solid var(--line);
    background: rgb(28 17 50 / 0.9);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    flex: 0 0 auto;
    text-decoration: none;
  }

  .brand span {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .panel {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1 1 auto;
    justify-content: flex-end;
  }

  .links {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    display: block;
    padding: 8px 13px;
    border-radius: 7px;
    color: var(--faint);
    text-decoration: none;
    font-size: var(--fs-small);
    transition: all 0.16s var(--ease);
  }

  .links a:hover {
    color: var(--tx);
    background: var(--void-2);
  }

  .cta {
    display: flex;
    gap: 9px;
    align-items: center;
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    cursor: pointer;
  }

  .burger span {
    display: block;
    width: 17px;
    height: 1.5px;
    background: var(--dim);
  }

  @media (max-width: 1080px) {
    .burger {
      display: flex;
    }

    .panel {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      padding: 0 var(--pad-page);
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      background: var(--void);
      border-bottom: 1px solid transparent;
      transition:
        max-height 0.3s var(--ease),
        opacity 0.25s var(--ease),
        padding 0.3s var(--ease);
    }

    .panel.is-open {
      max-height: 80vh;
      opacity: 1;
      overflow-y: auto;
      padding: 16px var(--pad-page) 22px;
      border-bottom-color: var(--line);
    }

    .links {
      flex-direction: column;
    }

    .links a {
      padding: 11px 4px;
      font-size: var(--fs-lead);
    }

    .cta {
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }
  }
</style>
