---
import Mark from './Mark.astro';
import { copy } from '../copy';
import { LINKS, VERSION } from '../lib/site';

const t = copy.footer;

/** Structure and URLs here; every label comes from the copy module. */
const COLUMNS = [
  {
    id: 'download',
    links: [
      { id: 'windows', href: LINKS.windowsDirect, external: true },
      { id: 'apple', href: LINKS.testFlight, external: true },
      { id: 'android', href: LINKS.googlePlay, external: true },
      { id: 'linux', href: LINKS.releaseTag, external: true },
      { id: 'bedrockAddon', href: LINKS.curseforgeBedrock, external: true },
      { id: 'javaPlugin', href: LINKS.modrinth, external: true },
    ],
  },
  {
    id: 'docs',
    links: [
      { id: 'wiki', href: LINKS.wiki, external: false },
      { id: 'streamDeck', href: LINKS.streamDeck, external: true },
      { id: 'clientWs', href: '/websocket', external: false },
      { id: 'serverApi', href: '/api', external: false },
    ],
  },
  {
    id: 'community',
    links: [
      { id: 'discord', href: LINKS.discord, external: true },
      { id: 'youtube', href: LINKS.youtube, external: true },
      { id: 'patreon', href: LINKS.patreon, external: true },
      { id: 'github', href: LINKS.repo, external: true },
    ],
  },
] as const;
---

<footer class="foot">
  <div class="inner">
    <div class="brand">
      <div class="lockup">
        <Mark cell={4} />
        <span>Bedrock Voice Chat</span>
      </div>
      <p>{t.blurb}</p>
    </div>

    {
      COLUMNS.map((col) => (
        <nav aria-label={t.columns[col.id]}>
          <h2>{t.columns[col.id]}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                >
                  {t.links[l.id]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="copy">
    <span>{t.copyright(new Date().getFullYear())}</span>
    <span class="num">v{VERSION} · {t.source}</span>
  </div>
</footer>

<style>
  .foot {
    padding: clamp(48px, 6vw, 72px) var(--pad-page) 34px;
    border-top: 1px solid var(--line);
  }

  .inner {
    max-width: var(--maxw);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 34px;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .lockup span {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .brand p {
    font-size: var(--fs-small);
    color: var(--dim);
    margin: 14px 0 0;
    max-width: 34ch;
    line-height: 1.6;
  }

  h2 {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--faint);
    font-weight: 500;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  a {
    color: var(--dim);
    text-decoration: none;
    font-size: var(--fs-small);
    transition: color 0.16s var(--ease);
  }

  a:hover {
    color: var(--brand-lift);
  }

  .copy {
    max-width: var(--maxw);
    margin: 44px auto 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--faint);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
